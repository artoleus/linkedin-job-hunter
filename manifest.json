{
  "manifest_version": 3,
  "name": "JobTrail - Job Search Assistant",
  "version": "1.4",
  "description": "Organise your job search: track applications, remember your answers to application questions, and follow up with your network. Not affiliated with LinkedIn.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "storage/storage.js",
        "shared/terms.js",
        "shared/text-utils.js",
        "shared/answer-bank.js",
        "shared/uk-places.js",
        "content/job-detector.js",
        "content/network-crawler.js",
        "content/network-expander.js",
        "content/connection-monitor.js",
        "content/job-applicator.js",
        "content/welcome-messenger.js",
        "content/linkedin.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JobTrail",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "JobTrail"
}
