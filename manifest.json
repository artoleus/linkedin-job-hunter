{
  "manifest_version": 3,
  "name": "LinkedIn Job Hunter",
  "version": "1.0",
  "description": "Discover job opportunities through your LinkedIn network",
  
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  
  "host_permissions": [
    "https://*.linkedin.com/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": [
        "storage/storage.js",
        "shared/text-utils.js",
        "shared/answer-bank.js",
        "content/job-detector.js",
        "content/network-crawler.js",
        "content/network-expander.js",
        "content/connection-monitor.js",
        "content/job-applicator.js",
        "content/linkedin.js"
      ],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LinkedIn Job Hunter"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
