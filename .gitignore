# Personal identifiable information
*.personal
user-data.json
settings.json
user-settings.json

# Chrome extension user data (stored by Chrome, but just in case)
chrome-storage/
user-storage/

# Any files with personal info
*personal*
*credentials*
*secrets*

# Environment files
.env
.env.local
.env.*.local

# API keys and tokens
*.key
*.secret
*.token

# Logs that might contain personal info
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build outputs (if any)
dist/
build/
*.zip
*.crx
*.pem

# Node modules (if added later)
node_modules/

# Temporary files
tmp/
temp/
*.tmp

# User-specific test data
test-data/
mock-data/
sample-data/

# Backup files
*.bak
*.backup
backup/
